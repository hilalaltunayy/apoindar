# ─────────────────────────────────────────────────────────────
# Apoindar — environment template. Copy to .env.local and fill in.
# NEVER commit a real .env file. Service-role keys stay server-only.
# ─────────────────────────────────────────────────────────────

# --- Database (Supabase Postgres) ---
# Pooled connection (app runtime). Supabase → Project Settings → Database → Connection string → "Transaction" pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (Prisma migrations only).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"
# Optional OAuth providers (leave blank to disable)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Supabase (Storage + public client) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Do not prefix with NEXT_PUBLIC. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="provider-media"

# --- Payments (marketplace) ---
# V1 uses the mock adapter. Production provider requires explicit approval.
PAYMENT_PROVIDER="mock" # mock | <selected-provider>
PAYMENT_MOCK_ALWAYS_SUCCEED="true"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development" # development | staging | production
