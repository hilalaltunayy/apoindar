# Apoindar mobile — Expo public env (safe to expose in the client bundle).
# Copy to .env.local for real-device testing.

# Base URL of the Apoindar web/API backend the app talks to.
# - iOS simulator: http://localhost:3000 works
# - Android emulator: use http://10.0.2.2:3000 (auto-rewritten from localhost)
# - Real device: your machine's LAN IP (e.g. http://192.168.1.20:3000) or an
#   `npx expo start --tunnel` URL / a deployed staging URL.
EXPO_PUBLIC_API_URL=http://localhost:3000
